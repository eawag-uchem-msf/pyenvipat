^\.claude$
^\.devcontainer$
^CLAUDE\.md$

# Python package (issue #5): not part of the R source tarball. src/envipat
# in particular can contain a locally-built .cpython-*.so and __pycache__,
# neither of which belongs in a portable R source package. Note
# .Rbuildignore is independent of .gitignore -- R CMD build reads the
# working directory directly, so Python-side build/test caches need their
# own entries here even though git never tracks them.
^pyproject\.toml$
^setup\.py$
^src/envipat$
^src/envipat\.egg-info$
^tests/test_core\.py$
^\.pytest_cache$
^__pycache__$
^build$
